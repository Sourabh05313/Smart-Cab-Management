	<queryString language="SQL">
		<![CDATA[SELECT
     my_payment.`payment_id` AS my_payment_payment_id,
     my_payment.`card_holder_name` AS my_payment_card_holder_name,
     my_payment.`payment_type` AS my_payment_payment_type,
     my_payment.`card_no` AS my_payment_card_no,
     my_payment.`cvv` AS my_payment_cvv,
     my_payment.`card_expiry_date` AS my_payment_card_expiry_date,
     my_payment.`Total_amout` AS my_payment_Total_amout,
     my_payment.`paydate` AS my_payment_paydate
FROM
     `my_payment` my_payment]]>
	</queryString>
