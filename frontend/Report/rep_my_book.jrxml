	<queryString language="SQL">
		<![CDATA[SELECT
     my_booking.`Booking_id` AS my_booking_Booking_id,
     my_booking.`driver_name` AS my_booking_driver_name,
     my_booking.`contact` AS my_booking_contact,
     my_booking.`pic_address` AS my_booking_pic_address,
     my_booking.`drop_address` AS my_booking_drop_address,
     my_booking.`pic_time` AS my_booking_pic_time,
     my_booking.`drop_time` AS my_booking_drop_time,
     my_booking.`Book_date` AS my_booking_Book_date,
     my_booking.`pic_date` AS my_booking_pic_date,
     my_booking.`drop_date` AS my_booking_drop_date,
     my_booking.`Distance` AS my_booking_Distance,
     my_booking.`Rate` AS my_booking_Rate,
     my_booking.`total_amount` AS my_booking_total_amount,
     my_booking.`status` AS my_booking_status
FROM
     `my_booking` my_booking]]>
	</queryString>
